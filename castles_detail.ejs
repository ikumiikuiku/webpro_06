<!DOCTYPE html>
<html>
<head><title><%= data.name %>の詳細</title></head>
<body>
    <h2><%= data.name %> の詳細</h2>
    <ul>
        <li><b>所在地:</b> <%= data.pref %></li>
        <li><b>高さ:</b> <%= data.height %></li>
        <li><b>アクセス:</b> <%= data.access %></li>
        <li><b>面積:</b> <%= data.area %></li>
    </ul>
    <p><a href="/castles">一覧に戻る</a></p>
</body>
</html>