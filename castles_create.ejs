<!DOCTYPE html>
<html>
<head><title>城の新規登録</title></head>
<body>
    <h2>新しい城を登録</h2>
    <form action="/castles" method="POST">
        <div>
            <label>城の名前:</label>
            <input type="text" name="name" required>
        </div>
        <div>
            <label>所在地(県):</label>
            <input type="text" name="pref">
        </div>
        <div>
            <label>高さ:</label>
            <input type="text" name="height">
        </div>
        <div>
            <label>最寄駅と距離:</label>
            <input type="text" name="access">
        </div>
        <div>
            <label>面積:</label>
            <input type="text" name="area">
        </div>
        <br>
        <input type="submit" value="登録">
    </form>
    <a href="/castles">一覧に戻る</a>
</body>
</html>