<!DOCTYPE html>
<html>
<head><title><%= data.name %>の詳細</title></head>
<body>
    <h2><%= data.name %></h2>
    <ul>
        <li><b>発売日:</b> <%= data.date %></li>
        <li><b>区分:</b> <%= data.type %></li>
        <li><b>曲の長さ:</b> <%= data.duration %></li>
        <li><b>感想:</b> <%= data.impression %></li>
    </ul>
    <p><a href="/shishamo">一覧に戻る</a></p>
</body>
</html>